{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings"]
  },
  "include": ["code.ts", "ops.ts", "variables.ts", "ui.ts", "../protocol.ts"]
}
